# Basis-URL für GetSongBPM. Passe sie an die API an, die du nutzen möchtest.
SONGBPM_BASE_URL=https://api.getsongbpm.com
# Pfad für den Endpunkt. {id} wird mit der Spotify Track ID ersetzt (optional).
SONGBPM_PATH_TEMPLATE=/tempo/
# Name des Query-Parameters für den API-Key (leer lassen, wenn du einen Header nutzen willst).
SONGBPM_API_KEY_PARAM=api_key
# Header-Name für den API-Key (falls statt Query-Param gewünscht, z. B. X-RapidAPI-Key)
SONGBPM_AUTH_HEADER=
# Namen der Query-Parameter für ID, Song und Artist.
SONGBPM_ID_PARAM=id
SONGBPM_TITLE_PARAM=song
SONGBPM_ARTIST_PARAM=artist
# Dein GetSongBPM API-Key
SONGBPM_API_KEY=
# Port für das lokale Backend
PORT=3000
